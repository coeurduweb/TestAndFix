# Copy to .env and fill. Every variable is optional except the password.

# Password for the checking tools (generators stay public).
# Production: generate a hash with `npm run hash-password -w server -- 'your password'`
TESTANDFIX_PASSWORD_HASH=
# Development only: plain password, used when no hash is set
TESTANDFIX_PASSWORD=
# Cookie signing secret (generated and stored in the database when empty)
TESTANDFIX_SESSION_SECRET=
TESTANDFIX_PUBLIC_URL=http://localhost:3000
TESTANDFIX_PORT=3000
TESTANDFIX_RETENTION_DAYS=90

# Test addresses: <id>@TESTANDFIX_MAIL_DOMAIN. Production: an MX record of this subdomain points to the server.
TESTANDFIX_MAIL_DOMAIN=testandfix.localhost
TESTANDFIX_SMTP_PORT=2525
TESTANDFIX_SMTP_TLS_KEY=
TESTANDFIX_SMTP_TLS_CERT=
# Behind an MTA relay (Postfix with smtp_send_xforward_command=yes): CIDRs allowed to send XFORWARD,
# so the report shows the original sender IP, HELO and TLS. Empty = XFORWARD refused (direct MX).
# Docker behind the host Postfix: 172.16.0.0/12,127.0.0.1/32
TESTANDFIX_SMTP_TRUSTED_RELAYS=

# Fallback reception: catch-all mailbox read over IMAP IDLE
TESTANDFIX_IMAP_HOST=
TESTANDFIX_IMAP_PORT=993
TESTANDFIX_IMAP_SECURE=true
TESTANDFIX_IMAP_USER=
TESTANDFIX_IMAP_PASS=
TESTANDFIX_IMAP_MAILBOX=INBOX
TESTANDFIX_IMAP_DOMAIN=

# SpamAssassin (spamd)
SPAMD_HOST=127.0.0.1
SPAMD_PORT=783

# Reputation sources with a free key (each is optional; a missing key is shown, never blocking)
GSB_API_KEY=
VT_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=

# Host agent used by the "Vider les caches" button (see agent/README.md)
TESTANDFIX_AGENT_URL=http://host.docker.internal:47625
TESTANDFIX_AGENT_TOKEN=
